# URL base de la API Hakone (sin /api/v1 al final)
# Desarrollo: backend en local (ver PORT en Hakone-API/.env)
# Producción: URL pública de la API desplegada
NEXT_PUBLIC_API_URL=http://localhost:4001

# WhatsApp de soporte: se usa en el banner de vencimiento y en la pantalla de
# suscripción vencida. Solo dígitos, SIN "+" ni espacios ni guiones, porque se
# concatena en un link https://wa.me/<numero>.
# Ej: para +54 9 11 2345-6789 -> 5491123456789
NEXT_PUBLIC_SUPPORT_WHATSAPP=5491123456789
